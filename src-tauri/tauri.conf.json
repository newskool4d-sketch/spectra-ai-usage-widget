{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SPECTRA",
  "version": "0.1.0",
  "identifier": "com.spectra.ai-usage-widget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SPECTRA AI 사용 현황",
        "width": 1280,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": false
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["spectra"]
      },
      "mobile": [
        {
          "scheme": ["spectra"]
        }
      ]
    }
  }
}
