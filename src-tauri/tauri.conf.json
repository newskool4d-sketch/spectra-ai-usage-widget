{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SPECTRA",
  "version": "0.2.2",
  "identifier": "com.spectra.ai-usage-widget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": []
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["spectra"]
      },
      "mobile": [
        {
          "scheme": ["spectra"]
        }
      ]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQwRjZCM0UxRkE5MDIxMkIKUldRcklaRDY0YlAyUUhOS2xPaVNaeXhGUThodGw2eHY4MERNQkNnaVUyOE9xNnVMYy9rWUNTbjUK",
      "endpoints": [
        "https://github.com/newskool4d-sketch/spectra-ai-usage-widget/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
