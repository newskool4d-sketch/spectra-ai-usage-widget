{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SPECTRA",
  "version": "0.2.1",
  "identifier": "com.spectra.ai-usage-widget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SPECTRA AI 사용 현황",
        "width": 430,
        "height": 720,
        "minWidth": 380,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["spectra"]
      },
      "mobile": [
        {
          "scheme": ["spectra"]
        }
      ]
    }
  }
}
